# BTC_Futures_E2E 페이퍼 봇 — **봇 전용 Linux 사용자(btcfut)의 user 유닛**. E2E 수집기 사용자·유닛·데이터 디렉터리와 분리.
# 설치: 런북 docs/runbook_vps.md §3 (~/.config/systemd/user/ 에 복사 · loginctl enable-linger btcfut)
# 🔒 수집기 우선: 낮은 CPU·IO 우선순위 + 메모리 상한. 상한은 user 위임(cgroup memory)이 켜져 있어야 적용된다 — 런북 §4 확인 명령.
# 🔒 --mode paper 고정. LIVE 기동 경로는 러너에 없다(설계서 §10 체크리스트·사용자 승인 전).
[Unit]
Description=BTC_Futures_E2E paper bot (BTCUSDT)
After=network-online.target
Wants=network-online.target
#  [Unit]에 둔다 — [Service]에 두면 systemd가 조용히 무시한다(E2E 2026-08-15)
OnFailure=btcfut-failed@%n.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/BTC_Futures_E2E
EnvironmentFile=%h/BTC_Futures_E2E/.env
ExecStart=%h/BTC_Futures_E2E/.venv/bin/python -m ops.run_bot --mode paper --var-dir %h/BTC_Futures_E2E/var --db %h/BTC_Futures_E2E/var/bot.sqlite
Restart=on-failure
RestartSec=15
#  SIGTERM → 러너가 피드를 멈추고 shard 종료 플러시·상태 저장·정지 알림까지 한다
KillSignal=SIGTERM
TimeoutStopSec=60
Nice=10
CPUWeight=50
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=700M
StandardOutput=append:%h/BTC_Futures_E2E/logs/bot.log
StandardError=append:%h/BTC_Futures_E2E/logs/bot.log

[Install]
WantedBy=default.target
