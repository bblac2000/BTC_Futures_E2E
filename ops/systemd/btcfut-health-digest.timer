[Unit]
Description=BTC_Futures_E2E daily digest 00:40 UTC

[Timer]
#  E2E digest(00:30)·quality(00:10)와 분리
OnCalendar=*-*-* 00:40:00 UTC
#  하루 1통 요약은 놓치면 따라잡는 편이 낫다 → Persistent 유지. 부팅 시 따라잡기가 00:10~00:12에 겹칠 수 있으나
#  digest는 상태 파일 읽기 + 텔레그램 1통(수백 KB)뿐이다(Codex 2026-09-18 #2 수용 · sync는 :20이라 같은 위험이 훨씬 작다).
Persistent=true

[Install]
WantedBy=timers.target
