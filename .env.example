# BTC_Futures_E2E — 환경변수 예시
# 사용: cp .env.example .env  → 값 채우기. `.env`는 git 미추적(.gitignore).
# 🚫 다른 프로젝트(E2E_Hybrid_Bot · BreakoutTrading · ExecVerifyBot)와 토큰·키를 공유하지 않는다 — 이 봇 전용 값을 넣는다.
# ⚠️ 거래소 규칙 값(tick/step/MIN_NOTIONAL/수수료 등)은 여기 넣지 않는다 — 런타임 API 조회가 진리원이다.

# ── 텔레그램 (notify/sender.py · ops/run_bot.py) ───────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 명령을 받을 주인 ID(쉼표 구분 정수) — 비어 있으면 봇이 기동하지 않는다. 개인 채팅이면 보통 TELEGRAM_CHAT_ID와 같은 값.
TELEGRAM_OWNER_IDS=

# ── Drive 복제 (ops/drive_sync.py · ops/prune.py) ───────────────────
# '<rclone remote>:<이 봇 전용 폴더>' — E2E_Hybrid_Bot 폴더를 가리키면 거부한다.
BTCFUT_DRIVE_REMOTE=

# ── 바이낸스 USDⓈ-M API (페이퍼 러너는 읽지 않는다 — 공개 GET + 캡처 스냅샷. scripts/capture_account_snapshot.py 전용) ─────────
# 페이퍼 단계 권장: **읽기 전용 권한 키**(거래·출금 권한 끔) + IP 제한(도쿄 VPS).
# 서명 조회(leverageBracket·commissionRate·positionSide/dual·multiAssetsMargin·positionRisk)에 필요하다.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── ⛔ 미사용(2026-09-15 테스트넷 폐기) — scripts/testnet_fee_probe.py 전용이던 값. 채우지 않는다 ──────────
# 공식 문서 2026-09-15 확인: REST base = https://demo-fapi.binance.com (옛 주소 testnet.binancefuture.com)
# 🔴 테스트넷 사이트에서 발급한 키만. 메인넷 키를 넣으면 스크립트가 거부한다. 테스트넷 호스트 밖 URL도 거부.
BINANCE_TESTNET_BASE_URL=https://demo-fapi.binance.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
